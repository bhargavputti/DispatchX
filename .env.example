# ==============================================================================
# DispatchX Environment Configuration Template (Placeholders only - no real secrets)
# Copy to .env for local development with your custom values
# ==============================================================================

# Core Monolith Role (all | api | worker)
DISPATCHX_ROLE=all

# Application URLs
DISPATCHX_PUBLIC_URL=http://localhost:8080
DISPATCHX_FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 16)
POSTGRES_DB=dispatchx
POSTGRES_USER=dispatchx_user
POSTGRES_PASSWORD=placeholder_db_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dispatchx
SPRING_DATASOURCE_USERNAME=dispatchx_user
SPRING_DATASOURCE_PASSWORD=placeholder_db_password

# Cache & In-Memory (Redis 7)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Event Broker (Kafka KRaft)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security & Secrets (Must be changed in production / staging)
# 256-bit secret for HS256 JWT access tokens
DISPATCHX_JWT_SECRET=placeholder_hs256_secret_key_minimum_32_characters_long
# 32-byte hex key for AES-256-GCM signing secret encryption
DISPATCHX_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Seeded Admin Identity (First boot only)
DISPATCHX_ADMIN_EMAIL=admin@dispatchx.local
DISPATCHX_ADMIN_PASSWORD=placeholder_admin_password_min_10_chars

# External Providers (Fake provider used for local/test)
DISPATCHX_EMAIL_PROVIDER=fake
DISPATCHX_RESEND_API_KEY=re_placeholder_resend_api_key
DISPATCHX_MAIL_FROM=notifications@example.com

# Delivery Workers (Disabled by default)
DISPATCHX_WORKER_EMAIL_ENABLED=false
DISPATCHX_WORKER_WEBHOOK_ENABLED=false

# Webhook signing-secret encryption key: base64 of 32 random bytes, NO default.
# Generate via: openssl rand -base64 32
DISPATCHX_WEBHOOK_SECRET_KEY=

# Demo & Sandbox settings
DISPATCHX_DEMO_PUBLIC=false
