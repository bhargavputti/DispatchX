# ==========================================================================
# DispatchX Production Environment Variables
# ==========================================================================
# Copy this file to `.env` in the same directory and fill in real values.
# NEVER commit the `.env` file to version control.
#
# Generate secrets with a CSPRNG:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
#   bash/macOS:  openssl rand -base64 32
# ==========================================================================

# ── Domain & TLS (Caddy) ──────────────────────────────────────────────────
# The fully qualified domain name Caddy will obtain a Let's Encrypt certificate for.
# Also used as the base for DISPATCHX_PUBLIC_URL and DISPATCHX_FRONTEND_URL (https://${DOMAIN}).
DOMAIN=dispatchx.example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=dispatchx
POSTGRES_USER=dispatchx_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── JWT Signing ───────────────────────────────────────────────────────────
# HS256 key, minimum 32 characters. Used for tenant and admin JWTs.
DISPATCHX_JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET_MIN_32_CHARS

# ── Admin Bootstrap ───────────────────────────────────────────────────────
# First-boot only: seeds the initial operator account. Change the password
# immediately after first login.
DISPATCHX_ADMIN_EMAIL=admin@yourcompany.com
DISPATCHX_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_10

# ── Email (Resend) ────────────────────────────────────────────────────────
DISPATCHX_EMAIL_PROVIDER=resend
DISPATCHX_RESEND_API_KEY=re_CHANGE_ME
DISPATCHX_MAIL_FROM=notifications@yourdomain.com

# ── Webhook ───────────────────────────────────────────────────────────────
# Base64 of 32 CSPRNG bytes. Required for webhook channel.
DISPATCHX_WEBHOOK_SECRET_KEY=CHANGE_ME_BASE64_WEBHOOK_SECRET

# ── Workers ───────────────────────────────────────────────────────────────
DISPATCHX_WORKER_EMAIL_ENABLED=true
DISPATCHX_WORKER_WEBHOOK_ENABLED=true
DISPATCHX_WORKER_INAPP_ENABLED=true

# ── Infrastructure Workers ────────────────────────────────────────────────
DISPATCHX_OUTBOX_RELAY_ENABLED=true
DISPATCHX_RECONCILER_ENABLED=true
DISPATCHX_RECOVERY_ENABLED=false
DISPATCHX_RESILIENCE_ENABLED=false

# ── DLQ Consumers ─────────────────────────────────────────────────────────
DISPATCHX_DLQ_CONSUMER_ENABLED=false
DISPATCHX_DLQ_DLT_CONSUMER_ENABLED=false

# ── Observability ─────────────────────────────────────────────────────────
DISPATCHX_TRACE_SAMPLING=0.1
DISPATCHX_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# ── Grafana (obs profile only) ────────────────────────────────────────────
# Anonymous access is enabled by default with Admin role for seamless SSO from
# the DispatchX Admin Console. The credentials below are used for direct master admin access.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

